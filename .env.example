# XAMPP default: user root, empty password. Change if yours is different.
DATABASE_URL="mysql://root:@localhost:3306/smartrider"

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Used only by `npm run db:seed` to create the first admin
ADMIN_NAME="SmartRider Admin"
ADMIN_MOBILE="03000000000"
ADMIN_PASSWORD="Admin@12345"
